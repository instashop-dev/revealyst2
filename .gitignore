# Dependencies
node_modules/

# Build output
dist/
build/

# Generated training data (reproducible via `npm run generate:corpus -w ml`)
ml/data/

# Python training environment
ml/.venv/

# Training intermediates (regenerated by ml/python/train.py; only the int8
# artifact + metadata are committed)
ml/models/prompt-scorer-v1/checkpoint/
ml/models/prompt-scorer-v1/encoder-checkpoint/
ml/models/prompt-scorer-v1/onnx/model.onnx

# Packaging artifacts (regenerated by CI and uploaded as a workflow artifact)
*.zip
# Locally packed extension (chrome --pack-extension) — dist.pem is a private
# signing key and must never be committed.
extension/dist.crx
extension/dist.pem

# Test / coverage
coverage/
playwright-report/
test-results/

# Cloudflare
.wrangler/
.dev.vars

# Environment
.env
.env.*
!.env.example

# Local overrides
*.local

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Editor / OS
.DS_Store
Thumbs.db
*.log
.eslintcache
.idea/
.vscode/

# Tooling metadata
.reasonix/
reasonix.toml
