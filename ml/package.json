{
  "name": "@revealyst/ml",
  "version": "0.1.0",
  "description": "Revealyst ML assets — training notes, ONNX export scripts and model artifact registry.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "generate:corpus": "node src/generate-corpus.ts",
    "train:model": "python python/train.py",
    "export:onnx": "python python/export_onnx.py",
    "eval:model": "python python/eval.py",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@revealyst/scoring": "*"
  }
}
