# Reference for local development environment variables.
# Actual values go into git-ignored files (workers/.dev.vars, .env.local).

OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
DATABASE_URL=postgres://revealyst:CHANGE_ME@localhost:5432/revealyst
VECTORIZE_NAMESPACE=prompt-patterns
JWT_SECRET=
APP_URL=http://localhost:8788
# App creator (admin) — comma-separated emails allowed to see /api/admin/*
# and impersonate users. Production value comes from the GitHub Actions secret
# ADMIN_EMAILS (set as a Worker secret); leave empty to disable the admin API.
ADMIN_EMAILS=
