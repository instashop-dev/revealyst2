{
  "name": "@revealyst/scoring",
  "version": "0.1.0",
  "description": "Revealyst prompt scoring engine — self-contained module (rule-based + ONNX adapter with fallback), usable from extension and web app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@xenova/transformers": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@xenova/transformers": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  }
}
