{
  "name": "revealyst",
  "version": "0.1.0",
  "private": true,
  "description": "Revealyst — turn every prompt into a step forward. AI prompt coaching & team analytics companion for non-technical SME teams.",
  "workspaces": [
    "packages/*",
    "extension",
    "web",
    "workers",
    "db",
    "vectorize",
    "ml"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
